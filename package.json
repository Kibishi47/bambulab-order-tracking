{
  "name": "bambulab-order-tracking",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "db:migrate": "tsx server/database/migrate.ts",
    "db:reset": "rm -f data/bambulab.db data/bambulab.db-wal data/bambulab.db-shm && tsx server/database/migrate.ts",
    "db:seed": "tsx server/database/seed.ts",
    "seed:minimal": "tsx server/database/seeds/minimal.ts",
    "seed:pending": "tsx server/database/seeds/pending.ts",
    "seed:full": "tsx server/database/seeds/full.ts",
    "seed:clean": "tsx server/database/seeds/clean.ts",
    "typecheck": "vue-tsc --noEmit",
    "audit": "knip",
    "duplicates": "jscpd server app.vue components pages composables types --threshold 5",
    "check": "npm run typecheck && npm run audit && npm run duplicates"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.2",
    "lucide-vue-next": "^1.0.0",
    "nuxt": "^4.5.2",
    "vue": "^3.5.42",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@nuxtjs/tailwindcss": "^6.14.0",
    "@types/better-sqlite3": "^9.6.0",
    "autoprefixer": "^10.6.1",
    "drizzle-kit": "^0.31.10",
    "jscpd": "^5.3.0",
    "knip": "^6.37.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vue-tsc": "^3.3.11"
  }
}
